<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.client.controller.MemberFormController"
        styleClass="book-form-root">

    <center>

        <VBox
                maxWidth="600"
                spacing="25"
                styleClass="book-form-card">

            <padding>
                <Insets
                        top="40"
                        right="45"
                        bottom="40"
                        left="45"/>
            </padding>


            <!-- HEADER -->

            <VBox spacing="5">

                <Label
                        fx:id="formTitle"
                        text="Add Member"
                        styleClass="form-title"/>

                <Label
                        fx:id="formSubtitle"
                        text="Add a new member to your library."
                        styleClass="form-subtitle"/>

            </VBox>


            <!-- FIRST NAME -->

            <VBox spacing="8">

                <Label
                        text="First Name"
                        styleClass="field-label"/>

                <TextField
                        fx:id="firstNameField"
                        promptText="Enter first name"
                        prefHeight="45"
                        styleClass="form-field"/>

            </VBox>


            <!-- LAST NAME -->

            <VBox spacing="8">

                <Label
                        text="Last Name"
                        styleClass="field-label"/>

                <TextField
                        fx:id="lastNameField"
                        promptText="Enter last name"
                        prefHeight="45"
                        styleClass="form-field"/>

            </VBox>


            <!-- ERROR -->

            <Label
                    fx:id="errorLabel"
                    wrapText="true"
                    styleClass="form-error"/>


            <!-- BUTTONS -->

            <HBox
                    alignment="CENTER_RIGHT"
                    spacing="10">

                <Button
                        text="Cancel"
                        onAction="#onCancelButtonClick"
                        prefHeight="45"
                        styleClass="secondary-button"/>

                <Button
                        text="Save Member"
                        onAction="#onSaveButtonClick"
                        prefHeight="45"
                        styleClass="primary-button"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>