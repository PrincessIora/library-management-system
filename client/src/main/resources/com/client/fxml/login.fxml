<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.client.controller.LoginController"
        styleClass="login-root">

    <center>
        <VBox
                alignment="CENTER"
                maxWidth="420"
                spacing="18"
                styleClass="login-card">

            <padding>
                <Insets top="45" right="45" bottom="45" left="45"/>
            </padding>

            <Label
                    text="📚"
                    styleClass="logo"/>

            <Label
                    text="Library Management System"
                    styleClass="title"/>

            <Label
                    text="Welcome back"
                    styleClass="subtitle"/>

            <VBox spacing="7">
                <Label
                        text="Username"
                        styleClass="field-label"/>

                <TextField
                        fx:id="usernameField"
                        promptText="Enter your username"
                        prefHeight="45"/>
            </VBox>

            <VBox spacing="7">
                <Label
                        text="Password"
                        styleClass="field-label"/>

                <PasswordField
                        fx:id="passwordField"
                        promptText="Enter your password"
                        prefHeight="45"
                        onAction="#onLoginButtonClick"/>
            </VBox>

            <Label
                    fx:id="errorLabel"
                    wrapText="true"
                    styleClass="error-label"/>

            <Button
                    text="Sign In"
                    onAction="#onLoginButtonClick"
                    maxWidth="Infinity"
                    prefHeight="48"
                    styleClass="login-button"/>

        </VBox>
    </center>

</BorderPane>