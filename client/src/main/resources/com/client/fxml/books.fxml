<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.client.controller.BookController"
        styleClass="books-root">

    <!-- TOP BAR -->
    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="top-bar">

            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <VBox spacing="3">

                <Label
                        text="📚 Library"
                        styleClass="app-title"/>

                <Label
                        text="Book Management"
                        styleClass="page-subtitle"/>

            </VBox>

            <HBox
                    HBox.hgrow="ALWAYS"/>

            <Button
                    text="↻ Refresh"
                    onAction="#onRefreshButtonClick"
                    styleClass="secondary-button"/>

        </HBox>
    </top>


    <!-- MAIN CONTENT -->
    <center>
        <VBox
                spacing="20"
                styleClass="content">

            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>


            <!-- PAGE HEADER -->
            <HBox
                    alignment="CENTER_LEFT"
                    spacing="15">

                <VBox
                        spacing="5">

                    <Label
                            text="Books"
                            styleClass="page-title"/>

                    <Label
                            text="View and manage the books in your library."
                            styleClass="page-description"/>

                </VBox>

                <HBox
                        HBox.hgrow="ALWAYS"/>

                <Button
                        text="+ Add Book"
                        onAction="#onAddBookButtonClick"
                        styleClass="primary-button"/>

            </HBox>


            <!-- SEARCH -->

            <HBox
                    spacing="15"
                    alignment="CENTER_LEFT"
                    styleClass="search-container">

                <!-- TITLE SEARCH -->

                <HBox
                        spacing="8"
                        alignment="CENTER_LEFT"
                        HBox.hgrow="ALWAYS">

                    <TextField
                            fx:id="titleSearchField"
                            promptText="Search by book title..."
                            prefHeight="42"
                            HBox.hgrow="ALWAYS"
                            styleClass="search-field"/>

                    <Button
                            text="Search Title"
                            onAction="#onTitleSearchButtonClick"
                            prefHeight="42"
                            styleClass="primary-button"/>

                </HBox>


                <!-- AUTHOR SEARCH -->

                <HBox
                        spacing="8"
                        alignment="CENTER_LEFT"
                        HBox.hgrow="ALWAYS">

                    <TextField
                            fx:id="authorSearchField"
                            promptText="Search by author..."
                            prefHeight="42"
                            HBox.hgrow="ALWAYS"
                            styleClass="search-field"/>

                    <Button
                            text="Search Author"
                            onAction="#onAuthorSearchButtonClick"
                            prefHeight="42"
                            styleClass="primary-button"/>

                </HBox>

            </HBox>
            <!-- BOOK TABLE -->
            <TableView
                    fx:id="bookTable"
                    VBox.vgrow="ALWAYS"
                    styleClass="book-table">

                <columns>

                    <TableColumn
                            fx:id="idColumn"
                            text="ID"
                            prefWidth="70"/>

                    <TableColumn
                            fx:id="titleColumn"
                            text="Title"
                            prefWidth="250"/>

                    <TableColumn
                            fx:id="authorColumn"
                            text="Author"
                            prefWidth="200"/>

                    <TableColumn
                            fx:id="yearColumn"
                            text="Year"
                            prefWidth="180"/>

                    <TableColumn
                            fx:id="statusColumn"
                            text="Status"
                            prefWidth="130"/>

                </columns>

                <placeholder>
                    <VBox
                            alignment="CENTER"
                            spacing="8">

                        <Label
                                text="📖"
                                styleClass="empty-icon"/>

                        <Label
                                text="No books found"
                                styleClass="empty-title"/>

                        <Label
                                text="Add a book or search your library."
                                styleClass="empty-description"/>

                    </VBox>
                </placeholder>

            </TableView>


            <!-- ACTION BUTTONS -->
            <HBox
                    spacing="10"
                    alignment="CENTER_RIGHT">

                <Button
                        text="Edit Selected"
                        onAction="#onEditBookButtonClick"
                        styleClass="secondary-button"/>

                <Button
                        text="Delete Selected"
                        onAction="#onDeleteBookButtonClick"
                        styleClass="danger-button"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>