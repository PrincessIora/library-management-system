<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.client.controller.LoanFormController"
        styleClass="book-form-root">

    <center>

        <VBox
                maxWidth="600"
                spacing="25"
                styleClass="book-form-card">

            <padding>
                <Insets
                        top="40"
                        right="45"
                        bottom="40"
                        left="45"/>
            </padding>


            <!-- HEADER -->

            <VBox spacing="5">

                <Label
                        fx:id="formTitle"
                        text="Borrow Book"
                        styleClass="form-title"/>

                <Label
                        fx:id="formSubtitle"
                        text="Enter the book and member information."
                        styleClass="form-subtitle"/>

            </VBox>


            <!-- BOOK ID -->

            <VBox spacing="8">

                <Label
                        fx:id="bookIdLabel"
                        text="Book ID"
                        styleClass="field-label"/>

                <TextField
                        fx:id="bookIdField"
                        promptText="Enter book ID"
                        prefHeight="45"
                        styleClass="form-field"/>

            </VBox>


            <!-- MEMBER ID -->

            <VBox
                    spacing="8"
                    managed="true"
                    visible="true">

                <Label
                        fx:id="memberIdLabel"
                        text="Member ID"
                        styleClass="field-label"/>

                <TextField
                        fx:id="memberIdField"
                        promptText="Enter member ID"
                        prefHeight="45"
                        styleClass="form-field"/>

            </VBox>


            <!-- ERROR -->

            <Label
                    fx:id="errorLabel"
                    wrapText="true"
                    styleClass="form-error"/>


            <!-- BUTTONS -->

            <HBox
                    alignment="CENTER_RIGHT"
                    spacing="10">

                <Button
                        text="Cancel"
                        onAction="#onCancelButtonClick"
                        prefHeight="45"
                        styleClass="secondary-button"/>

                <Button
                        fx:id="actionButton"
                        text="Borrow Book"
                        onAction="#onSaveButtonClick"
                        prefHeight="45"
                        styleClass="primary-button">



                </Button>

            </HBox>

        </VBox>

    </center>

</BorderPane>