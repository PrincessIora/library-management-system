<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.client.controller.MemberController"
        styleClass="members-root">

    <!-- TOP BAR -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="top-bar">

            <padding>
                <Insets
                        top="20"
                        right="30"
                        bottom="20"
                        left="30"/>
            </padding>

            <VBox spacing="3">

                <Label
                        text="📚 Library"
                        styleClass="app-title"/>

                <Label
                        text="Member Management"
                        styleClass="page-subtitle"/>

            </VBox>

            <HBox
                    HBox.hgrow="ALWAYS"/>

            <Button
                    text="↻ Refresh"
                    onAction="#onRefreshButtonClick"
                    styleClass="secondary-button"/>

        </HBox>

    </top>


    <!-- MAIN CONTENT -->

    <center>

        <VBox
                spacing="20"
                styleClass="content">

            <padding>
                <Insets
                        top="30"
                        right="40"
                        bottom="30"
                        left="40"/>
            </padding>


            <!-- HEADER -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="15">

                <VBox spacing="5">

                    <Label
                            text="Members"
                            styleClass="page-title"/>

                    <Label
                            text="View and manage library members."
                            styleClass="page-description"/>

                </VBox>

                <HBox
                        HBox.hgrow="ALWAYS"/>

                <Button
                        text="+ Add Member"
                        onAction="#onAddMemberButtonClick"
                        styleClass="primary-button"/>

            </HBox>


            <!-- SEARCH -->

            <HBox
                    spacing="10"
                    alignment="CENTER_LEFT"
                    styleClass="search-container">

                <TextField
                        fx:id="searchField"
                        promptText="Search by name..."
                        prefHeight="42"
                        HBox.hgrow="ALWAYS"
                        styleClass="search-field"/>

                <Button
                        text="Search"
                        onAction="#onSearchButtonClick"
                        prefHeight="42"
                        styleClass="primary-button"/>

            </HBox>


            <!-- MEMBER TABLE -->

            <TableView
                    fx:id="memberTable"
                    VBox.vgrow="ALWAYS"
                    styleClass="member-table">

                <columns>

                    <TableColumn
                            fx:id="idColumn"
                            text="ID"
                            prefWidth="80"/>

                    <TableColumn
                            fx:id="firstNameColumn"
                            text="First Name"
                            prefWidth="220"/>

                    <TableColumn
                            fx:id="lastNameColumn"
                            text="Last Name"
                            prefWidth="220"/>

                    <TableColumn
                            fx:id="fullNameColumn"
                            text="Full Name"
                            prefWidth="280"/>

                </columns>

                <placeholder>

                    <VBox
                            alignment="CENTER"
                            spacing="8">

                        <Label
                                text="👤"
                                styleClass="empty-icon"/>

                        <Label
                                text="No members found"
                                styleClass="empty-title"/>

                        <Label
                                text="Add a member or search your library."
                                styleClass="empty-description"/>

                    </VBox>

                </placeholder>

            </TableView>


            <!-- ACTIONS -->

            <HBox
                    spacing="10"
                    alignment="CENTER_RIGHT">

                <Button
                        text="Edit Selected"
                        onAction="#onEditMemberButtonClick"
                        styleClass="secondary-button"/>

                <Button
                        text="Delete Selected"
                        onAction="#onDeleteMemberButtonClick"
                        styleClass="danger-button"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>